# Real store data lives in ~/POSSystemData and is never part of this repo.
# Backups hold copies of it (staff password hashes, activity logs): keep them out too.
backups/

# Demo data is regenerated by demo.sh; the logins file holds the demo password.
**/demo/data/
**/demo/demo-logins.txt

# Staging copy used to try features before they go live (mirrors web/).
web-test/

# Build output
out/
build/
*.class

# Runtime files
*.log
*.web.tmp

# OS / IDE
.DS_Store
.idea/
*.iml
